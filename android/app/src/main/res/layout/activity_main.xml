<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml
    Root layout for MainActivity.  Uses CoordinatorLayout so the AppBarLayout
    can participate in scroll behaviour (e.g. hide-on-scroll in future).
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- ═══════════════════════════════════════════
         TOP BAR: AppBarLayout → Toolbar + ProgressBar
         ═══════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/toolbar_bg"
        app:elevation="4dp">

        <!-- Toolbar acts as the container for all nav / url / action widgets -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/toolbar_bg"
            app:contentInsetEnd="0dp"
            app:contentInsetStart="0dp">

            <!-- Horizontal row of controls inside the Toolbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <!-- Back navigation button -->
                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@android:color/black" />

                <!-- Forward navigation button -->
                <ImageButton
                    android:id="@+id/btn_forward"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Forward"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_forward"
                    android:tint="@android:color/black" />

                <!-- URL / search bar — expands to fill available width -->
                <EditText
                    android:id="@+id/url_bar"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_url_bar"
                    android:hint="@string/url_bar_hint"
                    android:imeOptions="actionGo"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textSize="14sp" />

                <!-- Tab switcher button with badge overlay -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btn_tabs"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/tabs"
                        android:padding="8dp"
                        android:src="@drawable/ic_tab_switcher"
                        android:tint="@android:color/black" />

                    <!-- Red badge showing open tab count, top-right corner -->
                    <TextView
                        android:id="@+id/tab_count_badge"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_tab_badge"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/tab_badge_text"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Overflow / three-dot menu button -->
                <ImageButton
                    android:id="@+id/btn_menu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menu"
                    android:padding="8dp"
                    android:src="@drawable/ic_more_vert"
                    android:tint="@android:color/black" />

            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- Thin loading progress bar — shown during page loads -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/colorPrimary"
            android:visibility="gone" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ═══════════════════════════════════════════
         CONTENT AREA: hosts the active WebTabView
         ═══════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
